  "outputs": {
    "deployment_summary": {
      "value": "\r\n============================================\r\nDEPLOYMENT SUMMARY\r\n============================================\r\n\r\nRESOURCE GROUP:\r\n  Name     : myRG\r\n  Location : centralindia\r\n\r\nVIRTUAL NETWORK:\r\n  Name     : myVNet\r\n  Address  : 10.0.0.0/16\r\n\r\nSUBNETS:\r\n  Public   : PublicSubnet (10.0.1.0/24)\r\n  Private  : PrivateSubnet (10.0.2.0/24)\r\n  AppGW    : AppGwSubnet (10.0.3.0/24)\r\n\r\nNSGs:\r\n  Public   : PublicNSG -\u003e Allow 22, 80, 443\r\n  Private  : PrivateNSG -\u003e Allow 5656, 22 (restricted)\r\n\r\nPUBLIC IPs:\r\n  PublicVM     : 20.204.43.217\r\n  NAT Gateway  : 20.198.119.30\r\n  App Gateway  : 4.247.129.232\r\n\r\nVIRTUAL MACHINES:\r\n  PublicVM:\r\n    - Name       : PublicVM\r\n    - Public IP   : 20.204.43.217\r\n    - Private IP  : 10.0.1.4\r\n    - App         : Nginx :80\r\n\r\n  PrivateVM:\r\n    - Name       : PrivateVM\r\n    - Public IP   : NONE\r\n    - Private IP  : 10.0.2.4\r\n    - App         : Node.js :5656\r\n    - Database    : MongoDB :27017\r\n\r\nNAT GATEWAY:\r\n  Name         : myNatGateway\r\n  Public IP    : 20.198.119.30\r\n  Attached To  : PrivateSubnet\r\n  Purpose      : Outbound internet for PrivateVM\r\n\r\nAPPLICATION GATEWAY:\r\n  Name         : myAppGateway\r\n  Public IP    : 4.247.129.232\r\n  Backend      : 10.0.2.4:5656\r\n  Purpose      : Expose PrivateVM app to internet\r\n\r\n============================================\r\nACCESS URLS\r\n============================================\r\nNginx (PublicVM)    : http://20.204.43.217\r\nNode.js (PrivateVM) : http://4.247.129.232\r\n\r\n============================================\r\nSSH ACCESS\r\n============================================\r\nStep 1: ssh azureuser@20.204.43.217\r\nStep 2: ssh azureuser@10.0.2.4\r\n\r\n============================================\r\nTRAFFIC FLOW\r\n============================================\r\nPUBLIC VM INBOUND:\r\n  Internet -\u003e 20.204.43.217:80 -\u003e PublicVM (Nginx)\r\n\r\nPRIVATE VM INBOUND:\r\n  Internet -\u003e 4.247.129.232:80 -\u003e AppGW -\u003e 10.0.2.4:5656 (Node.js)\r\n\r\nPRIVATE VM OUTBOUND:\r\n  PrivateVM -\u003e NAT Gateway -\u003e 20.198.119.30 -\u003e Internet\r\n\r\n============================================\r\n\r\n",
      "type": "string"
    }
  },
